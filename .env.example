# ---- LLM (optional) ----
# Leave CHATBI_AI_ENABLED=false to use the deterministic offline demo planner.
CHATBI_AI_ENABLED=false
# Canonical key name; OPENAI_API_KEY is still accepted as a fallback.
CHATBI_AI_API_KEY=
CHATBI_AI_BASE_URL=https://api.openai.com
CHATBI_AI_MODEL=gpt-4.1-mini
CHATBI_AI_TEMPERATURE=0.1
CHATBI_AI_MAX_TOKENS=1400
# Input / output price per 1M tokens. Leave 0 unless the gateway/model card
# publishes prices: token counts are always recorded, cost stays 0 when unknown.
CHATBI_AI_INPUT_COST_PER_MILLION=0
CHATBI_AI_OUTPUT_COST_PER_MILLION=0
CHATBI_AI_PRICE_CURRENCY=USD
# Request JSON-object output; falls back to plain text if the gateway rejects it.
CHATBI_AI_JSON_MODE=true
CHATBI_AI_TIMEOUT_SECONDS=45
CHATBI_AI_CONNECT_TIMEOUT_SECONDS=10
CHATBI_AI_MAX_RETRIES=2
CHATBI_AI_RETRY_BACKOFF_MS=800
# Prompt budget (characters, estimated before the request is sent).
CHATBI_AI_MAX_PROMPT_CHARS=28000
CHATBI_AI_MAX_SCHEMA_CHARS=16000
CHATBI_AI_MAX_HISTORY_CHARS=2000
CHATBI_AI_MAX_HISTORY_TURNS=3
CHATBI_AI_MAX_QUESTION_CHARS=2000
CHATBI_AI_ALLOW_DEMO_FALLBACK=false

# ---- Embeddings ----
# Only "hash" is implemented. Its vectors are lexical feature hashes, not
# semantic embeddings. A different provider/dimension needs a Flyway migration
# for semantic_embedding.embedding (currently vector(512)) plus a reindex.
CHATBI_EMBEDDING_PROVIDER=hash
CHATBI_EMBEDDING_DIMENSIONS=512

# ---- Infrastructure ----
POSTGRES_DB=chatbi
POSTGRES_USER=chatbi
POSTGRES_PASSWORD=chatbi
POSTGRES_PORT=5432
REDIS_PORT=6379

# Read-only execution account (created by infra/postgres/init/01-readonly.sql)
CHATBI_READONLY_DB_USER=chatbi_ro
CHATBI_READONLY_DB_PASSWORD=chatbi_ro

# ---- Query execution limits ----
CHATBI_QUERY_MAX_ROWS=500
CHATBI_QUERY_TIMEOUT_SECONDS=8
CHATBI_QUERY_MAX_EXPLAIN_COST=250000
CHATBI_QUERY_MAX_REPAIRS=2
