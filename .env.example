# ---- LLM (optional) ----
# Leave CHATBI_AI_ENABLED=false to use the deterministic offline demo planner.
CHATBI_AI_ENABLED=false
OPENAI_API_KEY=
CHATBI_AI_BASE_URL=https://api.openai.com
CHATBI_AI_MODEL=gpt-4.1-mini
# Input / output USD per 1M tokens, used for Prometheus cost metrics.
CHATBI_AI_INPUT_COST_PER_MILLION=0.40
CHATBI_AI_OUTPUT_COST_PER_MILLION=1.60

# ---- Infrastructure ----
POSTGRES_DB=chatbi
POSTGRES_USER=chatbi
POSTGRES_PASSWORD=chatbi
POSTGRES_PORT=5432
REDIS_PORT=6379

# Read-only execution account (created by infra/postgres/init/01-readonly.sql)
CHATBI_READONLY_DB_USER=chatbi_ro
CHATBI_READONLY_DB_PASSWORD=chatbi_ro

# ---- Authentication / authorization ----
# HS256 signing key. Must be at least 32 bytes. Replace for any shared deployment.
CHATBI_JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
CHATBI_JWT_ISSUER=chatbi
CHATBI_JWT_TTL_SECONDS=3600
# Legacy X-ChatBI-User identity header. Keep false except for isolated demos.
CHATBI_DEMO_HEADER_ENABLED=false
# Shared secret for the stdio MCP server. Leave empty to disable service auth.
CHATBI_MCP_SERVICE_TOKEN=
CHATBI_MCP_SERVICE_USER=mcp-service

# ---- Rate limiting / daily quota (single-instance, in-memory) ----
CHATBI_RATE_LIMIT_ENABLED=true
CHATBI_RATE_LIMIT_QPM=10
CHATBI_RATE_LIMIT_BURST=0
CHATBI_LOGIN_RATE_LIMIT_QPM=20
CHATBI_DAILY_TOKEN_LIMIT=2000000
CHATBI_DAILY_COST_LIMIT_USD=5.00

# ---- Query execution limits ----
CHATBI_QUERY_MAX_ROWS=500
CHATBI_QUERY_TIMEOUT_SECONDS=8
CHATBI_QUERY_MAX_EXPLAIN_COST=250000
CHATBI_QUERY_MAX_REPAIRS=2
