{
  "uid": "chatbi-prod",
  "title": "ChatBI Production",
  "tags": ["chatbi", "prod"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / s by status class",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"chatbi-backend\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"chatbi-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"chatbi-backend\"}[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Query latency P95 / P50",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chatbi_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(chatbi_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM calls / s by outcome",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(chatbi_llm_calls_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM latency P95 vs 60s deadline",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 55 }] }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chatbi_llm_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Audit fail-closed (10m)",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      },
      "targets": [
        { "refId": "A", "expr": "increase(chatbi_audit_fail_closed_total[10m])" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Quota and rate-limit rejections / s",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(chatbi_quota_rejected_total[5m]))",
          "legendFormat": "quota {{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (scope) (rate(chatbi_rate_limited_total[5m]))",
          "legendFormat": "rate {{scope}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Dependency up (postgres / redis)",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "chatbi_dependency_up",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": { "type": "prometheus", "uid": "chatbi-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"chatbi-backend\",area=\"heap\"})",
          "legendFormat": "heap"
        }
      ]
    }
  ]
}
