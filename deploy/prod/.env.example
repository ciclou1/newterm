# ChatBI production environment — copy to .env and fill every value.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Blank values below are mandatory: compose.yml uses ${VAR:?message} so the
# stack refuses to start until they are set. Never commit the real .env.
#
# Generate secrets:
#   JWT:              openssl rand -base64 48
#   DB/Redis/admin:   openssl rand -base64 32
#   metrics token:    openssl rand -hex 32

# ---- Required: database ----
POSTGRES_DB=chatbi
POSTGRES_USER=chatbi
POSTGRES_PASSWORD=
# Read-only analytical login created by infra/postgres/init/01-readonly.sql.
# Must differ from POSTGRES_PASSWORD; base64 has no quotes.
CHATBI_READONLY_DB_PASSWORD=

# ---- Required: Redis ----
CHATBI_REDIS_PASSWORD=

# ---- Required: authentication ----
# HS256, at least 32 bytes. docker/prod refuse the bundled dev value.
CHATBI_JWT_SECRET=
# Used once on first start to replace the seeded demo password (>= 12 chars).
CHATBI_BOOTSTRAP_ADMIN_USERNAME=lisi
CHATBI_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Required: internal Prometheus scrape credential ----
# Only accepted on /actuator/prometheus, grants ROLE_METRICS and nothing else.
CHATBI_METRICS_TOKEN=

# ---- Required: public endpoint ----
# Hostname/IP in the TLS certificate and in CORS/redirect URLs.
CHATBI_PUBLIC_HOST=chatbi.example.com
GRAFANA_ADMIN_PASSWORD=

# ---- Optional: TLS material ----
# Defaults to ./certs/server.crt and ./certs/server.key. Generate a local
# self-signed pair with scripts/gen-self-signed-cert.sh for verification.
# CHATBI_TLS_CERT=./certs/server.crt
# CHATBI_TLS_KEY=./certs/server.key

# ---- Optional: LLM gateway ----
# Leave disabled for the deterministic demo planner. With enabled=true a
# missing key stops startup instead of silently degrading.
CHATBI_AI_ENABLED=false
CHATBI_AI_API_KEY=
CHATBI_AI_BASE_URL=https://api.openai.com
CHATBI_AI_MODEL=gpt-4.1-mini
CHATBI_AI_TEMPERATURE=0.1
CHATBI_AI_MAX_TOKENS=1400
CHATBI_AI_TOTAL_TIMEOUT_SECONDS=60
CHATBI_AI_MAX_RETRIES=2
# Leave at 0 unless the model card publishes prices; cost metrics then stay 0.
CHATBI_AI_INPUT_COST_PER_MILLION=0
CHATBI_AI_OUTPUT_COST_PER_MILLION=0
CHATBI_AI_ALLOW_DEMO_FALLBACK=false

# ---- Optional: MCP service identity ----
# Shared with the stdio MCP server; empty disables service-token auth.
CHATBI_MCP_SERVICE_TOKEN=
CHATBI_MCP_SERVICE_USER=mcp-service

# ---- Optional: limits ----
CHATBI_RATE_LIMIT_QPM=10
CHATBI_LOGIN_RATE_LIMIT_QPM=20
CHATBI_DAILY_TOKEN_LIMIT=2000000
CHATBI_DAILY_COST_LIMIT_USD=5.00
CHATBI_QUERY_MAX_ROWS=500
CHATBI_QUERY_TIMEOUT_SECONDS=8

# Optional regional Maven mirror used only at image build time.
MAVEN_MIRROR_URL=

# ---- Optional: registry mirror / air-gapped builds ----
# Every image is digest-pinned in compose.yml and the Dockerfiles. To pull the
# same digests through a mirror, override the whole reference (registry prefix
# included); the digest must stay the same or the build will not be reproducible.
# POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector@sha256:...
# REDIS_IMAGE=docker.m.daocloud.io/library/redis@sha256:...
# PROMETHEUS_IMAGE=docker.m.daocloud.io/prom/prometheus@sha256:...
# GRAFANA_IMAGE=docker.m.daocloud.io/grafana/grafana-oss@sha256:...
# MAVEN_IMAGE=docker.m.daocloud.io/library/maven@sha256:...
# JRE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin@sha256:...
# NODE_IMAGE=docker.m.daocloud.io/library/node@sha256:...
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx@sha256:...

# ---- Backup retention ----
BACKUP_RETENTION_DAYS=14
